# ─────────────────────────────────────────────────────────────
# WorkoutMate — environment variables
# Copy this file to .env.local for development and fill in real
# values. Never commit .env.local or any file containing real
# secrets. Google OAuth credentials are configured inside the
# Supabase dashboard (Authentication → Providers → Google), NOT
# here — see README.md for the full setup walkthrough.
# ─────────────────────────────────────────────────────────────

# Supabase project settings (Project Settings → API in the Supabase dashboard)
# Safe to expose to the browser — protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses Row Level Security — used solely by trusted
# server routes (e.g. permanent account deletion). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI API key powering the AI Coach. Server-only.
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# Optional. Overrides the AI Coach's model (default: gpt-4o-mini). Server-only.
# OPENAI_MODEL=gpt-4o-mini

# Canonical site URL, no trailing slash. Used to build OAuth
# redirect URLs and absolute links (emails, OpenGraph, sitemap).
# Local dev:  http://localhost:3000
# Production: https://workoutmate.rishabh.uk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Deploy tooling only — read by the wrangler CLI at deploy time,
# never by the Next.js app itself, and never bundled into it.
# ─────────────────────────────────────────────────────────────

# A Cloudflare API token (My Profile → API Tokens → "Edit Cloudflare Workers"
# template covers deploy + custom domains). Used locally by `wrangler deploy`;
# in CI, set it as a repo/pipeline secret instead of a committed file.
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
